# Public domain used by Caddy for automatic TLS.
DOMAIN=app.example.com

# Public app URL compiled into frontend as NEXT_PUBLIC_API_URL.
PUBLIC_APP_URL=https://app.example.com

# Email for Let's Encrypt registration.
LETSENCRYPT_EMAIL=ops@example.com

# Docker Hub images used by production deploy/update flow.
BACKEND_IMAGE=docker.io/your-dockerhub-user/fittodoay-backend:latest
FRONTEND_IMAGE=docker.io/your-dockerhub-user/fittodoay-frontend:latest
DOCKER_PLATFORM=linux/amd64

# Docker service resource limits.
DB_MEMORY_LIMIT=256m
DB_MEMORY_RESERVATION=128m
DB_PIDS_LIMIT=96

BACKEND_MEMORY_LIMIT=256m
BACKEND_MEMORY_RESERVATION=128m
BACKEND_PIDS_LIMIT=96

FRONTEND_MEMORY_LIMIT=192m
FRONTEND_MEMORY_RESERVATION=96m
FRONTEND_PIDS_LIMIT=96
FRONTEND_NODE_OPTIONS=--max-old-space-size=512

CADDY_MEMORY_LIMIT=64m
CADDY_MEMORY_RESERVATION=16m
CADDY_PIDS_LIMIT=48

# Stable key for Next.js Server Actions (must stay constant across restarts/deploys).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=change-me-to-a-stable-32-byte-base64-key

# Backend host/origin allowlists for production domain.
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com

# Gunicorn runtime defaults (override if needed).
GUNICORN_WORKERS=1
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=180
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=200
GUNICORN_MAX_REQUESTS_JITTER=30

# Docker json-file log rotation.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
