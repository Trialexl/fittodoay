DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=fittodoey
DJANGO_DB_USER=fittodoey
DJANGO_DB_PASSWORD=fittodoey
DJANGO_DB_HOST=db
DJANGO_DB_PORT=5432
DJANGO_MEDIA_ROOT=/data/media

DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme123
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=User

IMPORT_EXERCISES_ON_START=False
DJANGO_MUSIC_UPLOAD_MAX_MB=130
DJANGO_TECHNIQUE_VIDEO_MAX_MB=80
DJANGO_TECHNIQUE_VIDEO_MAX_SECONDS=30
DJANGO_TECHNIQUE_ANALYSIS_TIMEOUT_SECONDS=45
DJANGO_TECHNIQUE_ANALYSIS_MODE=sync
DJANGO_TECHNIQUE_VIDEO_RETENTION_DAYS=30
DJANGO_TECHNIQUE_REVIEW_DAILY_LIMIT=10

# Gunicorn runtime
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=180
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5

# LLM agent
OPENROUTER_API_KEY=sk-your-openrouter-key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Vision-capable model for video technique review. Falls back to OPENROUTER_MODEL when empty.
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERRER=http://localhost:3000
OPENROUTER_APP_NAME=fitTODOay
